rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsEmail(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    function isValidUserDocument(email) {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'photoURL',
        'displayName'
      ])
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.email == email;
    }

    match /{email}/correo {
      allow read, delete: if ownsEmail(email);
      allow create, update: if ownsEmail(email) && isValidUserDocument(email);
    }

    match /CatchDex/{email} {
      allow read, write: if false;

      match /master/{masterId} {
        allow read, write: if ownsEmail(email);
      }

      match /pokedex/{pokemonId} {
        allow read, write: if ownsEmail(email);
      }
    }

    match /CatchDex/codigos/qr/{email} {
      allow read, create, update, delete: if ownsEmail(email);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
